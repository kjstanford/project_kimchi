# Copy to .env (gitignored) and adjust. Plain KEY=value lines, no quotes.
# Port the app is published on, on 127.0.0.1 only
PORT=8300

# Email when a live run ends, and after `alert_after_fails` failures in a row (src/measure/notify.py).
# Leave any of the first three empty to turn email off. For Gmail, NOTIFY_SMTP_PASSWORD is a 16-character
# app password (Google Account > Security > 2-Step Verification > App passwords), written without spaces.
# Check with: make notify-test PY=...
NOTIFY_SMTP_USER=
NOTIFY_SMTP_PASSWORD=
NOTIFY_EMAIL_TO=
NOTIFY_SMTP_HOST=smtp.gmail.com
NOTIFY_SMTP_PORT=587
